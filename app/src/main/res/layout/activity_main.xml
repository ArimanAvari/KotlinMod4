<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F6FB"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Задание 2: Поиск дубликатов"
            android:textColor="#232127"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pathText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#4B4651"
            android:textSize="14sp"
            tools:text="Директория: /data/user/0/com.example.kotlinmod4/files/search_test" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Таймаут (сек):"
                android:textColor="#232127"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/timeoutInput"
                android:layout_width="92dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/output_panel_bg"
                android:gravity="center"
                android:inputType="number"
                android:maxLines="1"
                android:padding="8dp"
                android:textColor="#232127"
                android:textSize="16sp"
                tools:text="5" />
        </LinearLayout>

        <Button
            android:id="@+id/startSearchButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:minHeight="0dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Найти дубликаты"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="0dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Остановить"
            android:textAllCaps="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="430dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/output_panel_bg"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:lineSpacingExtra="4dp"
            android:padding="18dp"
            android:textColor="#2B2830"
            android:textIsSelectable="true"
            android:textSize="15sp"
            tools:text="Сканируем директорию..." />
    </LinearLayout>
</ScrollView>
