<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FBF8F2"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Задание 2: Поиск дубликатов"
            android:textColor="#1F2430"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="SHA-256, корутины и общий таймаут"
            android:textColor="#6D6258"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pathText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#5A534A"
            android:textSize="14sp"
            tools:text="Директория: /data/user/0/com.example.kotlinmod4/files/search_test" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Таймаут (сек):"
                android:textColor="#2C313D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/timeoutInput"
                android:layout_width="96dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/input_box_bg"
                android:gravity="center"
                android:inputType="number"
                android:maxLines="1"
                android:padding="8dp"
                android:textColor="#1F2430"
                android:textSize="16sp"
                tools:text="5" />
        </LinearLayout>

        <Button
            android:id="@+id/startSearchButton"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/action_button_bg"
            android:minHeight="0dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Найти дубликаты"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_box_bg"
            android:minHeight="0dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Остановить"
            android:textAllCaps="false"
            android:textColor="#283242"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Лента поиска"
            android:textColor="#4D4740"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="440dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/output_panel_bg"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:lineSpacingExtra="4dp"
            android:padding="18dp"
            android:textColor="#2F2B34"
            android:textIsSelectable="true"
            android:textSize="15sp"
            tools:text="Сканируем директорию..." />
    </LinearLayout>
</ScrollView>
